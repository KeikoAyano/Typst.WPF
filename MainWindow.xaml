<Window x:Class="TypstWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPCodium"
        mc:Ignorable="d"
        Title="TPCodium"
        Icon="res/typst.png"
        Height="800" Width="1080">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open Folder" Click="OpenFolder"/>
                <MenuItem Header="Export" Click="ExportFile"/>
            </MenuItem>
            <MenuItem Header="Help">
                
            </MenuItem>
            
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            
        </ToolBar>
        <TreeView DockPanel.Dock="Left" Name="FileExplorerView" MinWidth="130" MaxWidth="200" HorizontalAlignment="Stretch">
        </TreeView>
        <RichTextBox Padding="20" Name="DocumentBlock">

        </RichTextBox>
    </DockPanel>
</Window>
